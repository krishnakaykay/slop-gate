# Google Gemini API Key (get one from Google AI Studio)
GEMINI_API_KEY=

# Configurable model IDs (benchmark across eval/run_benchmark.py to tune)
LLM_MODEL_REASONING=gemini-3.1-pro-preview
LLM_MODEL_FAST=gemini-3-flash-preview

# Optional server/session limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=40
SESSION_TTL_HOURS=24

# Optional hosted-beta guardrails & telemetry (Cloud Run)
# Leave SLOP_BETA_CODE empty for open access; set a value to require an invite code
SLOP_BETA_CODE=
SLOP_DAILY_RUN_LIMIT_PER_IP=15
SLOP_ADMIN_TOKEN=
SLOP_JSON_LOGS=true
